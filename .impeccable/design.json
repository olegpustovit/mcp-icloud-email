      "description": "Low-emphasis toolbar action.",
      "html": "<button class=\"ds-quiet\">Cancel</button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;gap:8px;height:30px;padding:0 12px;border:1.5px solid var(--line,#2E2E2C);font:500 11.5px/1 var(--f-mono,'IBM Plex Mono',monospace);text-transform:uppercase;letter-spacing:.05em;cursor:pointer;border-radius:0;transition:transform 80ms cubic-bezier(.2,.8,.2,1),box-shadow 80ms cubic-bezier(.2,.8,.2,1);background:transparent;color:var(--ink,#141413);border-color:transparent}.ds-quiet:hover{background:var(--tint,#E1E1DA)}.ds-quiet:focus-visible{outline:2px solid var(--acc,#4A4A46);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Framed input with a hard focus shadow.",
      "html": "<label class=\"ds-field\"><span>Email</span><input type=\"email\" placeholder=\"you@icloud.com\"></label>",
      "css": ".ds-field{display:grid;gap:6px;color:var(--ink,#141413);font:400 14px var(--f-mono,'IBM Plex Mono',monospace)}.ds-field>span{font:500 10.5px/1 var(--f-mono,'IBM Plex Mono',monospace);letter-spacing:.06em;text-transform:uppercase;color:var(--mute,#6A6A65)}.ds-field input{height:36px;padding:0 10px;border:1.5px solid var(--line,#2E2E2C);border-radius:0;background:var(--paper-3,#FCFCFA);color:inherit;font:inherit}.ds-field input:hover{border-color:var(--ink,#141413)}.ds-field input:focus{box-shadow:3px 3px 0 var(--acc,#4A4A46)}.ds-field input:focus-visible{outline:2px solid var(--acc,#4A4A46);outline-offset:2px}"
    },
    {
      "name": "Folder navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current folder inversion with a Doto count.",
      "html": "<nav aria-label=\"Mailboxes\" class=\"ds-nav\"><button aria-current=\"page\">Inbox <span>2</span></button><button>Archive</button></nav>",
      "css": ".ds-nav{font:400 12.5px/1 var(--f-mono,'IBM Plex Mono',monospace)}.ds-nav button{display:flex;align-items:center;gap:7px;width:100%;height:26px;padding:0 10px;background:var(--paper-2,#F3F3EF);color:var(--ink,#141413);border:0;text-align:left;font:inherit;cursor:pointer}.ds-nav button:hover{background:var(--tint,#E1E1DA)}.ds-nav button[aria-current]{background:var(--acc,#4A4A46);color:var(--acc-ink,#F3F3EF)}.ds-nav span{margin-left:auto;font:900 14px/1 var(--f-dot,Doto,monospace)}.ds-nav button:focus-visible{outline:2px solid var(--acc,#4A4A46);outline-offset:2px}"
    },
    {
      "name": "Search chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Removable square search token.",
      "html": "<button class=\"ds-chip\" aria-label=\"Remove from:priya\">from:priya \u00d7</button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 7px;border:1px solid var(--line,#2E2E2C);border-radius:0;background:var(--paper-3,#FCFCFA);color:var(--ink,#141413);font:400 12px/1 var(--f-mono,'IBM Plex Mono',monospace);cursor:pointer}.ds-chip:hover{background:var(--tint,#E1E1DA)}.ds-chip:focus-visible{outline:2px solid var(--acc,#4A4A46);outline-offset:2px}"
    },
    {
      "name": "Active window",
      "kind": "card",
      "refersTo": "window",
      "description": "Striped active title over framed paper.",
      "html": "<section class=\"ds-window\"><div class=\"ds-title\">MESSAGE_VIEWER<span></span></div><div class=\"ds-content\">Reading paper</div></section>",
      "css": ".ds-window{border:1.5px solid var(--line,#2E2E2C);background:var(--paper-2,#F3F3EF);color:var(--ink,#141413)}.ds-title{display:flex;align-items:center;gap:8px;height:26px;padding:0 9px;border-bottom:1.5px solid var(--line,#2E2E2C);background:var(--acc,#4A4A46);color:var(--acc-ink,#F3F3EF);font:500 11.5px/1 var(--f-mono,'IBM Plex Mono',monospace);letter-spacing:.05em}.ds-title span{height:11px;flex:1;background:repeating-linear-gradient(to bottom,currentColor 0 1px,transparent 1px 3px)}.ds-content{padding:22px;font:400 15px/1.65 var(--f-sans,\"IBM Plex Sans\",sans-serif)}"
    },
    {
      "name": "Message row",
      "kind": "custom",
      "refersTo": "message-row",
      "description": "Unread conversation with square marker and a two-line summary.",
      "html": "<button class=\"ds-row\"><span class=\"ds-unread\"></span><span class=\"ds-sender\">Priya<span class=\"ds-time\">07:45 AM</span></span><span class=\"ds-summary\"><b>Workshop dates</b> \u00b7 November works for me</span></button>",
      "css": ".ds-row{display:grid;grid-template-columns:22px 1fr;width:100%;height:60px;padding:9px 12px 9px 8px;border:0;border-bottom:1px solid var(--hair,#D0D0C9);background:var(--paper-2,#F3F3EF);color:var(--ink,#141413);text-align:left;cursor:pointer}.ds-row:hover{background:var(--tint,#E1E1DA)}.ds-unread{width:7px;height:7px;grid-row:1/3;margin:4px auto 0;background:var(--ink,#141413)}.ds-sender{font:700 13px/1.2 var(--f-mono,'IBM Plex Mono',monospace)}.ds-time{float:right;font:400 11.5px/1 var(--f-mono,'IBM Plex Mono',monospace);color:var(--mute,#6A6A65)}.ds-summary{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:400 13.5px/1.45 var(--f-sans,\"IBM Plex Sans\",sans-serif);color:var(--mute,#6A6A65)}.ds-summary b{font-weight:600;color:var(--ink,#141413)}.ds-row:focus-visible{outline:2px solid var(--acc,#4A4A46);outline-offset:2px}"
    },
    {
      "name": "Barcode progress",
      "kind": "custom",
      "refersTo": "progress",
      "description": "Framed striped progress fill.",
      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Import\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"60\"><span></span></div>",
      "css": ".ds-progress{height:22px;padding:2px;border:1.5px solid var(--line,#2E2E2C);background:var(--paper-3,#FCFCFA)}.ds-progress span{display:block;height:100%;width:60%;background:repeating-linear-gradient(90deg,var(--ink,#141413) 0 6px,transparent 6px 7px,var(--ink,#141413) 7px 10px,transparent 10px 12px,var(--ink,#141413) 12px 17px,transparent 17px 18px)}"
    }
  ],
  "narrative": {
    "northStar": "Terminal Mail",
    "overview": "A paper-and-graphite mail workstation with tiled windows, crisp bitmap chrome, and compact technical labels. Reading and composition use open, readable text areas inside the same framed structure. The visual authority is the user-selected native HTML specification, `docs/design/web-client.html` (artifact `mx4gywdnv23g`, version 3).\n\nThis records the shipped implementation in `web/src/style.css`, `design.js`, `views.js`, and `fonts.css`, checked against final desktop, phone reader, and phone compose captures in `.impeccable/review/`. The source CSS remains the authority for theme overrides and responsive state combinations.",
    "keyCharacteristics": [
      "Square windows with thin frames, striped active titles, and compact controls.",
      "Monochrome state inversion; optional signal colors only for mail flags.",
      "Pixel display type and icons paired with readable mail text.",
      "Crop marks, dither fills, barcode progress, and short stepped motion."
    ],
    "rules": [
      {
        "name": "The Inversion Rule",
        "body": "Active states use the paired accent background and accent ink; secondary text inside them uses accent muted ink.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Keep display lettering in headlines and identity; use Sans for message prose and Mono for interface chrome and structured metadata.",
        "section": "typography"
      },
      {
        "name": "The Window Rule",
        "body": "Use framed paper surfaces for persistent panes and hard offset shadows for floating or interactive elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pair accent, accent ink, and accent muted ink for every selected state.",
      "**Do** preserve square frames, inline bitmap SVG icons, and the existing paper hierarchy.",
      "**Do** keep long mail prose readable with the body role and the existing line-length cap.",
      "**Do** honor phone safe areas, pane visibility, keyboard focus, and reduced-motion preferences."
    ],
    "donts": [
      "**Don't** spread opt-in flag colors across primary actions or navigation.",
      "**Don't** replace the established square windows with rounded cards or blurred floating shadows.",
      "**Don't** use Silkscreen for long message bodies or substitute Unicode symbols for the bitmap icon set.",
      "**Don't** turn faint metadata colors or tiny decorative text into general-purpose reading styles."
    ]
  }
}
