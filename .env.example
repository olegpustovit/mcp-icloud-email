# iCloud Email MCP Server Configuration

# Your iCloud email address (Apple ID)
# Example: your-email@icloud.com
ICLOUD_EMAIL=

# App-specific password for iCloud Mail access
# IMPORTANT: This is NOT your regular iCloud password!
# Generate an app-specific password at: https://appleid.apple.com
# Navigate to: Sign-In and Security > App-Specific Passwords
# Your Apple ID must have two-factor authentication enabled
ICLOUD_PASSWORD=

# Hosted multiuser server (go run ./cmd/mail); keep these private.
MAIL_BASE_URL=https://mail.microapps.space
MAIL_ADDR=127.0.0.1:4290
MAIL_MONGODB_URI=mongodb://127.0.0.1:27017/mail
# Generate once with: openssl rand -base64 32. Back this up with MongoDB.
MAIL_ENCRYPTION_KEY=
MAIL_RESEND_API_KEY=
MAIL_EMAIL_FROM=Mail MCP <notifications@microapps.space>
